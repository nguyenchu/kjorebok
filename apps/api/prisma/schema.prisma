generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  trips        Trip[]
  places       Place[]
  vehicles     Vehicle[]
}

model Place {
  id           String   @id @default(cuid())
  userId       String
  label        String
  lat          Float
  lng          Float
  radiusMeters Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Trip {
  id                 String      @id @default(cuid())
  userId             String
  status             TripStatus  @default(ACTIVE)
  startedAt          DateTime
  endedAt            DateTime?
  distanceMeters     Float       @default(0)
  startAddress       String?
  endAddress         String?
  purpose            TripPurpose @default(PRIVATE)
  purposeNote        String?
  client             String?
  mode               TripMode    @default(CAR)
  vehicleId          String?
  odometerStart      Int?
  odometerEnd        Int?
  /// First and latest recorded position, kept here so trip lists and reports
  /// can match places without loading every point.
  startLat           Float?
  startLng           Float?
  endLat             Float?
  endLng             Float?
  /// Derived from TripPoint by processTrack (apps/api/src/lib/track); null
  /// until the trip has been processed. distanceMeters and mode are too.
  rawDistanceMeters  Float?
  maxSpeedKmh        Float?
  avgMovingSpeedKmh  Float?
  movingSeconds      Float?
  stoppedSeconds     Float?
  pointCount         Int?
  rejectedPointCount Int?
  /// Smoothed, simplified line for the map, set when the trip completes.
  track              Json?
  stops              Json?
  /// TRACK_PROCESSING_VERSION the derived columns were computed with.
  processingVersion  Int?
  /// Legacy JSON route. No longer written; its contents were copied into
  /// TripPoint and the column is dropped once no client depends on it.
  route              Json        @default("[]")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  points             TripPoint[]

  @@index([userId])
  @@index([status])
  @@index([vehicleId])
}

/// One GPS fix exactly as the phone reported it. Everything derived from a
/// trip's route (distance, speeds, the line on the map) is computed from these
/// rows, so the algorithm can improve and old trips can be recalculated.
model TripPoint {
  id               BigInt      @id @default(autoincrement())
  tripId           String
  /// GPS timestamp of the fix, not when the server received it.
  recordedAt       DateTime
  lat              Float
  lng              Float
  /// Horizontal accuracy in meters.
  accuracy         Float
  /// m/s as reported by the device; null when the device did not know.
  speed            Float?
  heading          Float?
  altitude         Float?
  altitudeAccuracy Float?
  source           PointSource @default(DEVICE)
  receivedAt       DateTime    @default(now())
  trip             Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// A fix is identified by its timestamp, which makes resending a batch whose
  /// response got lost harmless.
  @@unique([tripId, recordedAt])
}

enum PointSource {
  /// Sent by the app as a raw fix.
  DEVICE
  /// Copied from the legacy Trip.route JSON, already filtered on the phone.
  LEGACY_ROUTE
}

/// A vehicle the trips are logged against. Skatteetaten expects a kjørebok to
/// identify the car by registration number, so a trip without a vehicle is not
/// valid documentation.
model Vehicle {
  id           String      @id @default(cuid())
  userId       String
  label        String
  registration String
  type         VehicleType @default(PRIVATE)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips        Trip[]

  @@unique([userId, registration])
  @@index([userId])
}

enum VehicleType {
  /// Privatbil brukt i jobb — grunnlag for kjøregodtgjørelse
  PRIVATE
  /// Firmabil — grunnlag for fordelsbeskatning
  COMPANY
  /// Yrkesbil (varebil klasse 2 o.l.)
  WORK
}

enum TripStatus {
  ACTIVE
  COMPLETED
}

enum TripPurpose {
  PRIVATE
  WORK
}

enum TripMode {
  WALK
  CYCLE
  EBIKE
  CAR
  OTHER
}
