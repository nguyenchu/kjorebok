generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  trips        Trip[]
  places       Place[]
  vehicles     Vehicle[]
}

model Place {
  id           String   @id @default(cuid())
  userId       String
  label        String
  lat          Float
  lng          Float
  radiusMeters Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Trip {
  id             String      @id @default(cuid())
  userId         String
  status         TripStatus  @default(ACTIVE)
  startedAt      DateTime
  endedAt        DateTime?
  distanceMeters Float       @default(0)
  startAddress   String?
  endAddress     String?
  purpose        TripPurpose @default(PRIVATE)
  purposeNote    String?
  client         String?
  mode           TripMode    @default(CAR)
  vehicleId      String?
  odometerStart  Int?
  odometerEnd    Int?
  // Route stored as JSON array of GpsPoint objects
  // For production, consider PostGIS geography(LineString) instead
  route          Json        @default("[]")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([vehicleId])
}

/// A vehicle the trips are logged against. Skatteetaten expects a kjørebok to
/// identify the car by registration number, so a trip without a vehicle is not
/// valid documentation.
model Vehicle {
  id           String      @id @default(cuid())
  userId       String
  label        String
  registration String
  type         VehicleType @default(PRIVATE)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips        Trip[]

  @@unique([userId, registration])
  @@index([userId])
}

enum VehicleType {
  /// Privatbil brukt i jobb — grunnlag for kjøregodtgjørelse
  PRIVATE
  /// Firmabil — grunnlag for fordelsbeskatning
  COMPANY
  /// Yrkesbil (varebil klasse 2 o.l.)
  WORK
}

enum TripStatus {
  ACTIVE
  COMPLETED
}

enum TripPurpose {
  PRIVATE
  WORK
}

enum TripMode {
  WALK
  CYCLE
  EBIKE
  CAR
  OTHER
}
